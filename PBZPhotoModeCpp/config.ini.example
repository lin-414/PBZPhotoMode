; ================================================================
; PBZ Photo Mode (C++) 配置文件（UTF-8，可留空使用默认值）
; 放在 ue4ss\Mods\PBZPhotoModeCpp\config.ini
; 改完存盘后按 F2 重进摄影模式即可生效（或重启游戏）
; ================================================================

[keys]
; 进入/退出摄影模式
key_toggle = F2
; 显示/隐藏菜单
key_menu = T
; 冻结/恢复时间
key_freeze = F
; 重置相机到进入摄影模式时的位置/朝向/FOV
key_reset = R
; FOV 加减（小键盘 +/-，也可写 OEM_PLUS / OEM_MINUS）
key_fov_up = ADD
key_fov_down = SUBTRACT

[control]
; 常规移动速度（单位/秒）；按住 Shift 加速、Ctrl 减速
move_speed = 400
boost_mult = 4
slow_mult = 0.3
; 每单位鼠标位移转多少度
look_sensitivity = 0.1
pitch_limit = 89
invert_y = false
; 必须按住 Alt 才能自由转视角
free_look_requires_alt = true
; 进入摄影模式时屏蔽角色移动/视角输入（退出时还原）
block_game_input = true
; 左键上移/右键下移：translate=相机上下平移，look=俯仰
mouse_vertical_mode = translate
vertical_speed = 200

; ================================================================
; 手柄支持（v1.0.15 新增）
; ================================================================

[gamepad]
; 手柄支持总开关（false=不轮询手柄）
pad_enabled = true
; 进入/退出摄影模式：默认左右摇杆同时按下（LS=左摇杆按下 L3，RS=右摇杆按下 R3）
; 可用按钮：A B X Y LB RB LS RS BACK START GUIDE UP DOWN LEFT RIGHT LT RT
; 也认 PS 叫法（CROSS/CIRCLE/SQUARE/TRIANGLE/L1/R1/L2/R2/L3/R3/OPTIONS/SHARE/PS）
; 多个按钮用 + 连接（同时按住触发）；写 NONE 表示解绑该功能
pad_toggle = LS+RS
; 显示/隐藏菜单
pad_menu = START
; 冻结/恢复时间
pad_freeze = X
; 重置相机到进入摄影模式时位置/朝向/FOV
pad_reset = Y
; FOV 加减（十字键上/下）
pad_fov_up = UP
pad_fov_down = DOWN
; 右摇杆转视角速度（度/秒，全行程）
pad_look_speed = 180
; 左摇杆移动速度占 move_speed 的比例
pad_move_scale = 1
; 摇杆死区（0~0.5，摇杆有漂移就调大）
pad_deadzone = 0.15

[camera]
fov_default = 90
fov_min = 15
fov_max = 150
fov_step = 2

[effects]
hide_player = false
; 进入摄影模式时隐藏游戏 HUD（退出时恢复原可见性）
hide_game_hud = true
; 进入摄影模式时自动暂停时间（默认开启；false=进入后时间照常流动，可按 F 手动冻结）
auto_pause_time = true
; pause=游戏暂停（默认，真正冻结角色/敌人/特效）；dilation=只调全局时间倍率
freeze_mode = pause
freeze_dilation = 0.0001
restore_fov_on_exit = true
restore_view_on_exit = true

[ui]
; UE4SS 控制台里的 ImGui 面板（需要 UE4SS 控制台窗口）
imgui_tab = true
; 没有 ImGui 时用文字菜单兜底
hud_fallback = false

[misc]
log_level = info
dry_run = false
