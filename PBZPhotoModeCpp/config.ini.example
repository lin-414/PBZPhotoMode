; ================================================================
; PBZ Photo Mode (C++) 配置文件（UTF-8，可留空使用默认值）
; 放在 ue4ss\Mods\PBZPhotoModeCpp\config.ini
; 改完存盘后按 F2 重进摄影模式即可生效（或重启游戏）
; ================================================================

[keys]
; 进入/退出摄影模式
key_toggle = F2
; 冻结/恢复时间
key_freeze = F
; 重置相机到进入摄影模式时的位置/朝向/FOV
key_reset = R
; FOV 加减（小键盘 +/-，也可写 OEM_PLUS / OEM_MINUS）
key_fov_up = ADD
key_fov_down = SUBTRACT
; 俯仰（按住持续转）：方向键上 = 仰视 / 下 = 俯视
key_pitch_up = UP
key_pitch_down = DOWN
; 左右平移（按住持续移，速度 = move_speed × arrow_pan_mult）：方向键左 / 右
key_pan_left = LEFT
key_pan_right = RIGHT

[control]
; 常规移动速度（单位/秒）；按住 Shift 加速、Ctrl 减速
move_speed = 400
boost_mult = 4
slow_mult = 0.3
; 按住 Ctrl（手柄为按下右摇杆 RS）时鼠标/右摇杆视角速度的倍率，越小视角越精细
slow_look_mult = 0.1
; 每单位鼠标位移转多少度
look_sensitivity = 0.1
pitch_limit = 89
invert_y = false
; 必须按住 Alt 才能自由转视角
free_look_requires_alt = true
; 进入摄影模式时屏蔽角色移动/视角输入（退出时还原）
block_game_input = true
; 左键上移/右键下移：translate=相机上下平移，look=俯仰
mouse_vertical_mode = translate
vertical_speed = 200
; Q/E 滚转相机速度（度/秒）：E 顺时针，Q 逆时针；Shift 加速 / Ctrl 减速同样生效
roll_speed = 60
; 方向键上/下（与手柄十字键上/下）俯仰速度（度/秒）；Shift 加速 / Ctrl 减速同样生效
pitch_speed = 30
; 方向键/十字键左右平移速度占 move_speed 的比例（1 = 与 WASD/左摇杆同速）
arrow_pan_mult = 0.5

; ================================================================
; 手柄支持（v1.0.15 新增；v1.4.0 起原生支持 DualSense/DualShock4，USB 与蓝牙均可）
; ================================================================

[gamepad]
; 手柄支持总开关（false=不轮询手柄）
pad_enabled = true
; 进入/退出摄影模式：默认左右摇杆同时按下（LS=左摇杆按下 L3，RS=右摇杆按下 R3）
; Xbox 手柄走 XInput，PS 手柄（DualSense/DualShock4）走 DirectInput，键位写法完全一致
; 可用按钮：A B X Y LB RB LS RS BACK START GUIDE UP DOWN LEFT RIGHT LT RT
; 也认 PS 叫法（CROSS/CIRCLE/SQUARE/TRIANGLE/L1/R1/L2/R2/L3/R3/OPTIONS/SHARE/PS）
; 多个按钮用 + 连接（同时按住触发）；写 NONE 表示解绑该功能
pad_toggle = LS+RS
; 冻结/恢复时间
pad_freeze = X
; 重置相机到进入摄影模式时位置/朝向/FOV
pad_reset = Y
; FOV 加减（A/B；十字键已全部让位给视角调节；单击一格，按住先延迟约 0.35 秒再连发）
pad_fov_up = A
pad_fov_down = B
; 俯仰（按住持续转）：十字键上 = 仰视 / 下 = 俯视
pad_pitch_up = UP
pad_pitch_down = DOWN
; 左右平移（按住持续移）：十字键左 / 右
pad_pan_left = LEFT
pad_pan_right = RIGHT
; 固定键位（不占配置项）：RT/LT 升降；RB/LB 滚转相机（RB 顺时针 / LB 逆时针，与键盘 Q/E 同向）；
; L3/R3 变速（LS 加速 / RS 减速；两杆同时按住是进出模式组合键，此时不触发变速）；
; 按下右摇杆 RS 同时把右摇杆/鼠标视角速度放慢到 slow_look_mult 倍（精调）
; 右摇杆转视角速度（度/秒，全行程）
pad_look_speed = 60
; 左摇杆移动速度占 move_speed 的比例
pad_move_scale = 1
; 摇杆死区（0~0.5，摇杆有漂移就调大）
pad_deadzone = 0.15

[camera]
fov_default = 90
fov_min = 15
fov_max = 150
fov_step = 2
; 超宽屏（21:9/32:9）：进入摄影模式时解除游戏 16:9 画幅锁定（消除两侧黑边），退出还原
ultrawide_unlock = true

[effects]
hide_player = false
; 进入摄影模式时隐藏游戏 HUD（退出时恢复原可见性）
hide_game_hud = true
; 进入摄影模式时隐藏交互提示（可互物体旁的 E 键图标，退出时恢复）
hide_interact_prompt = true
; 进入摄影模式时隐藏敌人（怪物）血条（切到游戏自带"仅锁定目标"显示模式，退出时还原原模式）
hide_enemy_health_bars = true
; 进入摄影模式时隐藏对话字幕（关游戏字幕设置 + 藏字幕显示控件，退出时还原）
hide_subtitles = true
; 进入摄影模式时自动暂停时间（默认开启；false=进入后时间照常流动，可按 F 手动冻结）
auto_pause_time = true
; pause=游戏暂停（默认，真正冻结角色/敌人/特效）；dilation=只调全局时间倍率
freeze_mode = pause
freeze_dilation = 0.0001
; 冻结时同时暂停剧情/过场（Sequencer 播放器），解冻/退出时恢复。
; 剧情系统常绕过世界暂停自顾自播（画面像冻住但动作声音还在走），默认开启
freeze_sequences = true
; 冻结时把所有 Wwise 音频组件的音量归零（对话/环境/音乐一并静音，可恢复）。
; 声音在冻结期间继续无声播放，解冻恢复音量后当前句从原处继续
stop_wwise_on_freeze = true
restore_fov_on_exit = true
restore_view_on_exit = true

[ui]
; UE4SS 控制台里的 ImGui 诊断面板（需要 UE4SS 控制台窗口）；游戏内无菜单，纯快捷键操作
imgui_tab = true

[misc]
log_level = info
dry_run = false
